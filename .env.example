# Salin ke .env.local bila ingin memakai backend bersama (Supabase).
# Tanpa dua variabel ini aplikasi berjalan penuh dalam mode demo (data fiktif, tersimpan di peramban).
# Jangan pernah memasukkan service_role key ke variabel VITE_*: semuanya terlihat di peramban.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
